{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "platform-check": false
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/voxel99/dbsimple"
    },
    {
      "type": "vcs",
      "url": "https://github.com/voxel99/dbsimple-models"
    }
  ],
  "require": {
    "php": ">=8.4",
    "jam/dbsimple": "dev-main",
    "jam/dbsimple-models": "dev-main",
    "docusign/esign-client": "^6.16",
    "pipedrive/pipedrive": "^4.0",
    "ext-curl": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "jam\\": "."
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
